{
  "$schema": "https://json.schemastore.org/package",
  "packageManager": "pnpm@12.9.1",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "postinstall": "tsc",
    "test": "vitest run --coverage",
    "test:mutate": "stryker run",
    "lint": "pnpm run lint:prettier src && pnpm run lint:eslint",
    "lint:prettier": "prettier --check src",
    "lint:prettier:fix": "prettier --write src",
    "lint:eslint": "eslint src tests",
    "lint:eslint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "chance": "^1.1.13",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/chance": "^1.1.8",
    "@types/cors": "^2.8.19",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
